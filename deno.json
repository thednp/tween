{
  "name": "@thednp/tween",
  "version": "0.1.6",
  "license": "MIT",
  "description": "🌸 A Typescript sourced tweening engine with Tween and Timeline",
  "keywords": [
    "SSR",
    "animation",
    "animation engine",
    "animations",
    "cubic-bezier",
    "cubic-tween",
    "ease",
    "easing",
    "easing functions",
    "preact",
    "react",
    "server-side rendering",
    "solid-js",
    "svelte",
    "svg-morphing",
    "timeline",
    "tween",
    "typescript",
    "vanjs",
    "vue"
  ],
  "minimumDependencyAge": 0,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./preact": "./src/preact/index.ts",
    "./solid": "./src/solid/index.ts",
    "./svelte": "./src/svelte/index.svelte.ts",
    "./vue": "./src/vue/index.ts",
    "./vanjs": "./src/vanjs/index.ts"
  },
  "imports": {
    "@thednp/tween": "./src/index.ts",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.3.1",
    "@vitest/coverage-istanbul": "npm:@vitest/coverage-istanbul@^5.1.0",
    "@vitest/ui": "npm:@vitest/ui@^5.1.0",
    "happy-dom": "npm:happy-dom@^21.0.4",
    "preact": "npm:preact@^11.2.0",
    "react": "npm:react@^19.3.1",
    "solid-js": "npm:solid-js@^1.9.19",
    "svelte": "npm:svelte@^5.57.3",
    "svelte-preprocess": "npm:svelte-preprocess@^6.0.5",
    "svg-path-commander/util": "npm:svg-path-commander@^2.3.4/util",
    "vanjs-core": "npm:vanjs-core@^1.6.2",
    "vitest": "npm:vitest@^5.1.0",
    "vue": "npm:vue@^3.5.45"
  },
  "tasks": {
    "test": "deno task clean-coverage && vitest",
    "test:ui": "deno task clean-coverage && vitest --ui",
    "test:watch": "deno task clean-coverage && vitest --ui --watch",
    "clean-coverage": "rm -rf coverage .nyc_output",
    "lint": "deno lint src",
    "check": "deno check src/index.ts src/react/index.ts src/preact/index.ts src/solid/index.ts src/svelte/index.svelte.ts src/vue/index.ts src/vanjs/index.ts",
    "check:core": "deno check src/index.ts",
    "format": "deno fmt src",
    "fix": "deno lint src --fix",
    "up:play": "deno run -A scripts/update-playground.js",
    "up:deno": "deno update --latest && deno run -A scripts/update-deno.js"
  },
  "publish": {
    "include": [
      "src",
      "deno.json",
      "package.json",
      "README.md",
      "CHANGELOG.md",
      "AGENTS.md",
      "llms.txt",
      "LICENSE"
    ]
  },
  "exclude": ["coverage", "dist", "experiments", "node_modules", "playground", "test"]
}
