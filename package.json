{
  "name": "@thednp/tween",
  "version": "0.1.6",
  "description": "🌸 A Typescript sourced tweening engine with Tween and Timeline",
  "keywords": [
    "SSR",
    "animation",
    "animation engine",
    "animations",
    "cubic-bezier",
    "cubic-tween",
    "ease",
    "easing",
    "easing functions",
    "preact",
    "react",
    "server-side rendering",
    "solid-js",
    "svelte",
    "svg-morphing",
    "timeline",
    "tween",
    "typescript",
    "vanjs",
    "vue"
  ],
  "homepage": "https://github.com/thednp/tween",
  "bugs": {
    "url": "https://github.com/thednp/tween/issues"
  },
  "license": "MIT",
  "author": "thednp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thednp/tween.git"
  },
  "files": [
    "dist",
    "package.json",
    "AGENTS.md",
    "llms.txt",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "browser": "./dist/tween.min.js",
  "types": "./dist/tween/index.d.mts",
  "exports": {
    ".": "./dist/tween/index.mjs",
    "./preact": "./dist/preact/preact.mjs",
    "./react": "./dist/react/react.mjs",
    "./solid": "./dist/solid/solid.mjs",
    "./svelte": "./dist/svelte/tween.svelte.js",
    "./vanjs": "./dist/vanjs/vanjs.mjs",
    "./vue": "./dist/vue/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "pre-test": "vpr clean-coverage",
    "clean-coverage": "rm -rf coverage .nyc_output",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:ui": "vp test --ui --watch",
    "bench": "vp test bench",
    "dev": "cd playground/react && vpr up && vpr dev",
    "dev:preact": "cd playground/preact && vpr up && vpr dev",
    "dev:solid": "cd playground/solid && vpr up && vpr dev",
    "dev:svelte": "cd playground/svelte && vpr up && vpr dev",
    "dev:vue": "cd playground/vue && vpr up && vpr dev",
    "dev:vanjs": "cd playground/vanjs && vpr up && vpr dev",
    "format": "vp fmt",
    "lint": "deno lint src",
    "lint:ts": "deno lint src",
    "lint:types": "tsc --noEmit",
    "fix:ts": "deno lint src --fix",
    "build_": "vp pack && vp build",
    "build": "vp pack",
    "up:play": "deno run -A scripts/update-playground.js",
    "up:deno": "deno update --latest && deno run -A scripts/update-deno.js",
    "prepublishOnly": "vp update --latest && vpr up:deno && vpr up:play && vpr format && vpr lint && vpr build",
    "clean:playground": "rm -rf playground/**/node_modules playground/**/package-lock.json playground/**/pnpm-lock.yaml playground/**/bun.lockb playground/**/deno.lock",
    "clean:test": "rm -rf test/node_modules test/package-lock.json test/pnpm-lock.yaml test/bun.lockb test/deno.lock",
    "clean": "rm -rf node_modules && pnpm clean:playground && pnpm clean:test",
    "up-play": "for dir in playground/*/; do (cd \"$dir\" && pnpm update --latest); done;",
    "update-deps": "pnpm clean && pnpm update --latest && pnpm up-play",
    "prepare": "vp config"
  },
  "dependencies": {
    "@thednp/dommatrix": "^3.1.4",
    "preact": "^11.2.0",
    "react": "^19.3.1",
    "solid-js": "^1.9.19",
    "svelte": "^5.57.3",
    "svg-path-commander": "^2.3.4",
    "vanjs-core": "^1.6.2",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "happy-dom": "^21.0.4",
    "react-dom": "^19.3.1",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}